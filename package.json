{
  "name": "paro-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrar.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:preparar": "tsx server/db/migrar.ts && tsx server/db/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@nuxt/ui": "4.11.3",
    "@vueuse/core": "14.4.0",
    "drizzle-orm": "0.45.4",
    "echarts": "6.1.0",
    "maplibre-gl": "6.14.0",
    "nuxt": "4.6.1",
    "nuxt-auth-utils": "0.5.31",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "vue-echarts": "8.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "1.2.143",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "1.64.0",
    "@types/geojson": "7946.0.16",
    "@types/pg": "8.23.1",
    "@vite-pwa/nuxt": "1.1.1",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "happy-dom": "21.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
